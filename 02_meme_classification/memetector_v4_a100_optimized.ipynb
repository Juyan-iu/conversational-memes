      "source": [
        "import os, gc\n",
        "os.environ['PYTORCH_ALLOC_CONF'] = 'expandable_segments:True'  # 메모리 단편화 방지\n",
        "\n",
        "# ── 5-Fold CV 학습 ─────────────────────────────────────────────\n",
        "# 핵심 전략:\n",
        "#   전체 데이터 → test 15% 고정 분리\n",
        "#   나머지 85% → 5-Fold 교차검증\n",
        "#   각 fold에서 최고 모델 저장 → test에서 5모델 앙상블\n",
